# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- the system we evolve -------------------------------------------------
CONCIERGE_URL=https://<your-qa-service-host>
SKILL_API_KEY=
# local checkout used to validate file:line citations. Verification is meaningless
# without this, so it must point at a real clone of the codebase being documented.
TARGET_REPO=/Users/jeff/Git/Squidgy/codebase-concierge

# --- sponsors -------------------------------------------------------------
# agent.pioneer.ai -> Billing -> Get Pro -> promo code HACKATHONSF0724
PIONEER_API_KEY=

# docs.senso.ai/sign-up -> /api-keys   ($100 signup credit)
SENSO_API_KEY=

# aistudio.google.com -> Get API key   (free, no card)
GEMINI_API_KEY=
JUDGE_MODEL=gemini-2.5-flash

# replay.io -> Settings -> API Keys. Use access code HACKATHON for free access.
# Free tier is 25 credits/mo and one app scan costs ~20 — do not scan casually.
REPLAY_API_KEY=

# app.band.ai -> Agents (Pro via promo code TOKENBAND26)
BAND_REST_URL=https://app.band.ai/
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
BAND_API_KEY=

